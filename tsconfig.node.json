{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "electron-vite/node"
    ],
    "noEmit": true,
    "paths": {
      "@monte/core/*": [
        "./packages/core/src/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "packages/core/src/**/*"
  ]
}
